/*
 * Common Device Tree include for ASRock Rack B650D4U BMC family.
 */

#include "aspeed-g6.dtsi"
#include <dt-bindings/gpio/aspeed-gpio.h>  /* <-- ADD THIS LINE */

/ {
	aspeed_b650d4u_power: host-power-passthrough {
		compatible = "asrock,b650d4u-power-passthrough";
		aspeed,scu = <&syscon>;
	};

	aliases {
		serial0 = &uart5;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x20000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		pci_memory: region@9e000000 {
			reg = <0x9e000000 0x00400000>;
			no-map;
		};

		video_engine_memory: video {
			compatible = "shared-dma-pool";
			size = <0x04000000>;
			alignment = <0x01000000>;
			reusable;
		};

		gfx_memory: framebuffer {
			compatible = "shared-dma-pool";
			size = <0x01000000>;
			alignment = <0x01000000>;
			reusable;
		};
	};
};

&gfx {
	status = "okay";
	memory-region = <&gfx_memory>;
};

&gpio0 {
	gpio-line-names =
		/* A0-A7 */	"","","","","","","","",
		/* B0-B7 */	"","","","","","","","",
		/* C0-C7 */	"","","","","","","","",
		/* D0-D7 */	"","","","","","","","",
		/* E0-E7 */	"","","","","","","","",
		/* F0-F7 */     "","","","","","","","input-psu-pwrok-n",
		/* G0-G7 */	"","","","","","","","",
		/* H0-H7 */	"","","","","","","","",
		/* I0-I7 */	"","","","","","","","",
		/* J0-J7 */	"","","","","","","","",
		/* K0-K7 */	"","","","","","","","",
		/* L0-L7 */	"","","","","","","","",
		/* M0-M7 */	"","","","","","","","",
		/* N0-N7 */	"","","","","","","","",
		/* O0-O7 */	"","","","","","","","",
		/* P0-P7 */	"button-reset-n","control-reset-n",
				"button-power-n","control-power-n",
				"button-nmi-n","control-nmi-n",
				"","",
		/* Q0-Q7 */	"","","","","","","","",
		/* R0-R7 */	"","","","","","","","",
		/* S0-S7 */     "","","","bmc-ready","output-bmc-ready-n",
				"","","",
		/* T0-T7 */	"","","","","","","","",
		/* U0-U7 */	"","","","","","","","",
		/* V0-V7 */	"","","","","","","","",
		/* W0-W7 */	"","","","","","","","",
		/* X0-X7 */	"","","","","","","","",
		/* Y0-Y7 */	"","","","","","","","",
		/* Z0-Z7 */	"","","","","","","","";

	/* The vendor firmware asserts BMC ready by driving S4 low. */
	bmc-ready {
		gpio-hog;
		gpios = <ASPEED_GPIO(S, 4) GPIO_ACTIVE_LOW>;
		/* Active-low GPIO: logical high drives the physical pin low. */
		output-high;
		line-name = "output-bmc-ready-n";
	};
};

&fmc {
	status = "okay";

	flash@0 {
		reg = <0>;
		compatible = "jedec,spi-nor";
		label = "bmc";
		m25p,fast-read;
		spi-max-frequency = <50000000>;
		spi-rx-bus-width = <4>;
		status = "okay";

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			u-boot@0 {
				reg = <0x00000000 0x000e0000>;
				label = "u-boot";
				read-only;
			};

			u-boot-env@e0000 {
				reg = <0x000e0000 0x00020000>;
				label = "u-boot-env";
			};

			kernel@200000 {
				reg = <0x00200000 0x00800000>;
				label = "kernel";
			};

			rofs@a00000 {
				reg = <0x00a00000 0x02000000>;
				label = "rofs";
				read-only;
			};

			rwfs@2a00000 {
				reg = <0x02a00000 0x01600000>;
				label = "rwfs";
			};
		};
	};
};

&mac0 {
	status = "okay";
	phy-mode = "rgmii-id";
	phy-handle = <&ethphy0>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_rgmii1_default>;

	nvmem-cells = <&eth0_macaddress>;
	nvmem-cell-names = "mac-address";
};

&mac2 {
	status = "okay";
	phy-mode = "rmii";
	use-ncsi;
};

&mdio0 {
	status = "okay";

	ethphy0: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0>;
	};
};

&i2c7 {
	status = "okay";

	eeprom@57 {
		compatible = "st,24c128", "atmel,24c128";
		reg = <0x57>;
		pagesize = <16>;

		nvmem-layout {
			compatible = "fixed-layout";
			#address-cells = <1>;
			#size-cells = <1>;

			eth0_macaddress: macaddress@3f80 {
				reg = <0x3f80 6>;
			};
		};
	};
};

&uart5 {
	status = "okay";
};
