From: Prasanth Kumar Padarthi <prasanth.padarthi10@gmail.com>
Subject: [PATCH] power-control: allow missing optional GPIOs

Allow a platform to omit PowerButton, PostComplete, and ResetOut GPIO
lines. This is needed for B650D4U bring-up where host power output and
power-good feedback are being validated independently of GPIOs whose
board mappings have not yet been established.

Upstream-Status: Inappropriate [board-specific configuration]

Signed-off-by: Prasanth Kumar Padarthi <prasanth.padarthi10@gmail.com>

diff --git a/src/power_control.cpp b/src/power_control.cpp
index 50fcd96..065e55b 100644
--- a/src/power_control.cpp
+++ b/src/power_control.cpp
@@ -2796,13 +2796,17 @@ int main(int argc, char* argv[])
         }
     }
 
-    // Request POWER_BUTTON GPIO events
+        // Request POWER_BUTTON GPIO events
     if (powerButtonConfig.type == ConfigType::GPIO)
     {
-        if (!requestGPIOEvents(powerButtonConfig.lineName, powerButtonHandler,
-                               powerButtonLine, powerButtonEvent))
+        if (!powerButtonConfig.lineName.empty())
         {
-            return -1;
+            if (!requestGPIOEvents(powerButtonConfig.lineName,
+                                   powerButtonHandler, powerButtonLine,
+                                   powerButtonEvent))
+            {
+                return -1;
+            }
         }
     }
     else if (powerButtonConfig.type == ConfigType::DBUS)
@@ -2879,14 +2883,18 @@ int main(int argc, char* argv[])
     bool postCompleteConfigured = false;
     // Request POST_COMPLETE GPIO events
     if (postCompleteConfig.type == ConfigType::GPIO)
+{
+    if (!postCompleteConfig.lineName.empty())
     {
-        if (!requestGPIOEvents(postCompleteConfig.lineName, postCompleteHandler,
-                               postCompleteLine, postCompleteEvent))
+        if (!requestGPIOEvents(postCompleteConfig.lineName,
+                               postCompleteHandler, postCompleteLine,
+                               postCompleteEvent))
         {
             return -1;
         }
         postCompleteConfigured = true;
     }
+}
     else if (postCompleteConfig.type == ConfigType::DBUS)
     {
         static sdbusplus::bus::match_t postCompleteEventMonitor =
@@ -2919,18 +2927,13 @@ int main(int argc, char* argv[])
     }
 
     if (!resetOutConfig.lineName.empty())
+{
+    if (!setGPIOOutput(resetOutConfig.lineName, !resetOutConfig.polarity,
+                       line))
     {
-        if (!setGPIOOutput(resetOutConfig.lineName, !resetOutConfig.polarity,
-                           line))
-        {
-            return -1;
-        }
-    }
-    else
-    {
-        lg2::error("ResetOut name should be configured from json config file");
         return -1;
     }
+}
     // Release line
     line.reset();
 
